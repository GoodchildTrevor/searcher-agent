# Qdrant vector search service URL
SEARCH_URL=http://search_qdrant:8033/vector_search

# Ollama service URL
OLLAMA_URL=http://ollama:11434

# Model name to use with Ollama
OLLAMA_MODEL=ministral-3:14b

# Comma-separated list of Qdrant collection names to search
COLLECTIONS=mech,docs

# Trace logging (prompt tuning). Set to 1 to enable.
AGENT_TRACE_ENABLED=0
AGENT_TRACE_LOG_PATH=/app/logs/traces.jsonl

# API key for /agent-query (set to a strong secret)
API_KEY=
